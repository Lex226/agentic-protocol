{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-protocol://schemas/report.schema.json",
  "title": "Executor report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "repository",
    "base_sha",
    "head_sha",
    "protocol_version",
    "commands",
    "evidence",
    "changed_files",
    "limitations",
    "unchecked"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["instrumented", "human_confirmed", "not_checked"]
          },
          "result": {
            "enum": ["pass", "fail", "not_applicable"]
          },
          "detail": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_checked"
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "result": {
                  "enum": ["fail", "not_applicable"]
                }
              }
            }
          }
        ]
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unchecked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
